# Copy to .env and fill in what you use (or use .streamlit/secrets.toml)
# models: at least one
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=hf_xxxxxxxxxxxxxxxx
# Kaggle
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=xxxxxxxxxxxxxxxx
# cloud data (see README > Cloud data sources)
# AWS_PROFILE=
# MOTHERDUCK_TOKEN=
# SNOWFLAKE_ACCOUNT= / SNOWFLAKE_USER= / SNOWFLAKE_PAT=
# BIGQUERY_PROJECT=
# model overrides
# ANTHROPIC_MODEL=anthropic/claude-sonnet-5-5
# OPENAI_MODEL=openai/gpt-5-mini
# GEMINI_MODEL=gemini/gemini-2.5-flash
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# OLLAMA_MODEL=gpt-oss:120b-cloud   (cloud tags need `ollama signin`)
