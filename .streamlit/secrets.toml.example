# Copy to .streamlit/secrets.toml (gitignored) or paste into Community Cloud > Settings > Secrets.
# UPPER_CASE keys are copied into the environment at startup. Fill only what you use.

# --- models (at least one) ---
ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY = ""
# GEMINI_API_KEY = ""
# HF_TOKEN = ""

# --- Kaggle ---
# KAGGLE_USERNAME = ""
# KAGGLE_KEY = ""

# --- object storage (read via DuckDB) ---
# AWS_ACCESS_KEY_ID = ""
# AWS_SECRET_ACCESS_KEY = ""
# AWS_REGION = "eu-west-2"
# GCS_KEY_ID = ""        # HMAC key, not a service-account JSON
# GCS_SECRET = ""
# AZURE_STORAGE_CONNECTION_STRING = ""

# --- warehouses ---
# MOTHERDUCK_TOKEN = ""
# SNOWFLAKE_ACCOUNT = "orgname-accountname"
# SNOWFLAKE_USER = ""
# SNOWFLAKE_PAT = ""                     # or SNOWFLAKE_PRIVATE_KEY_FILE for key-pair auth
# SNOWFLAKE_WAREHOUSE = "COMPUTE_WH"
# SNOWFLAKE_ROLE = ""                    # use a read-only role
# BIGQUERY_PROJECT = ""
# GOOGLE_APPLICATION_CREDENTIALS = "/path/to/service-account.json"

# --- optional sign-in (st.login, needs streamlit[auth]) ---
# ALLOWED_EMAILS = "you@example.com"
# [auth]
# redirect_uri = "https://<your-app>.streamlit.app/oauth2callback"
# cookie_secret = "<random string>"
# client_id = ""
# client_secret = ""
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
